# Copy this file to .env.local and fill in the values from your Supabase project
# Supabase dashboard: Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Comma-separated list of admin emails (no spaces)
# Example: NEXT_PUBLIC_ADMIN_EMAILS=me@example.com,friend@example.com
NEXT_PUBLIC_ADMIN_EMAILS=REPLACE_WITH_YOUR_ADMIN_EMAIL@example.com

# Cloudinary unsigned upload — sign up free at https://cloudinary.com/users/register/free
# Cloud name: top of your dashboard (e.g. dxyz1234).
# Upload preset: Settings → Upload → Upload presets → Add. Set "Signing Mode" to Unsigned.
# Used to upload submission images and avatars directly from the browser.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name-here
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset-here

# ---- Admin email notifications (issue #54) — server-only, never NEXT_PUBLIC_ ----
# Supabase dashboard → Project Settings → API Keys → service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Resend (https://resend.com) → API Keys. EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=re_your-resend-key-here
EMAIL_FROM="Campaign Chronicle <notifications@campaign-chronicle.app>"
# Random string; Vercel sends it as a Bearer token to /api/cron/weekly-digest.
# Generate with: openssl rand -hex 32
CRON_SECRET=your-random-secret-here
# Optional: base URL used for links in emails (defaults to https://www.campaign-chronicle.app)
# APP_URL=https://www.campaign-chronicle.app
