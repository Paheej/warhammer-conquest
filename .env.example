# Copy this file to .env.local and fill in the values from your Supabase project
# Supabase dashboard: Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Comma-separated list of admin emails (no spaces)
# Example: NEXT_PUBLIC_ADMIN_EMAILS=me@example.com,friend@example.com
NEXT_PUBLIC_ADMIN_EMAILS=REPLACE_WITH_YOUR_ADMIN_EMAIL@example.com

# Cloudinary unsigned upload — sign up free at https://cloudinary.com/users/register/free
# Cloud name: top of your dashboard (e.g. dxyz1234).
# Upload preset: Settings → Upload → Upload presets → Add. Set "Signing Mode" to Unsigned.
# Used to upload submission images and avatars directly from the browser.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name-here
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset-here

# Service role key — Supabase dashboard: Settings > API > service_role (secret, never expose to the browser)
# Used server-side only, to email admins about pending submissions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Resend — sign up free at https://resend.com, verify your domain (Domains tab),
# then create an API key (API Keys tab). Used to email admins when submissions
# need review.
RESEND_API_KEY=your-resend-api-key-here
RESEND_FROM_EMAIL=notifications@yourdomain.com

# Shared secret for the Supabase → app webhook that fires on new submissions.
# Generate any random string (e.g. `openssl rand -hex 32`) and use the same
# value here and in the Supabase Database Webhook header — see README.
SUPABASE_WEBHOOK_SECRET=generate-a-random-secret

# Shared secret Vercel Cron uses to call the weekly digest endpoint.
# Generate a random string and set the same value as an env var in Vercel.
CRON_SECRET=generate-a-random-secret

# Your deployed site URL — used to build the admin-queue link in notification emails.
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
